{
  "name": "picoedit",
  "version": "0.1.0",
  "description": "PICO-8 cart (.p8.png) extraction/compaction toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test 'src/{cmd,internal}/**/*.test.ts' && vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "node --import tsx src/cmd/cli.ts",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "fast-png": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.28.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
