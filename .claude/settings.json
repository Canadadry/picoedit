{
  "permissions": {
    "allow": [
      "Read",
      "Edit(src/**)",
      "Edit(test/**)",
      "Edit(docs/**)",
      "Edit(cart/**)",
      "Edit(package.json)",
      "Edit(tsconfig.json)",
      "Edit(.gitignore)",
      "Edit(README.md)",
      "Edit(vite.config.ts)",
      "Write(src/**)",
      "Write(test/**)",
      "Write(docs/**)",
      "Write(cart/**)",
      "Write(package.json)",
      "Write(tsconfig.json)",
      "Write(.gitignore)",
      "Write(README.md)",
      "Write(vite.config.ts)",
      "Bash(mkdir *)",
      "Bash(rm tmp/*)",
      "Bash(rm -r tmp/*)",
      "Bash(rm -rf tmp/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git mv *)",
      "Bash(sh scripts/git-hooks/install.sh)",
      "Bash(make install)",
      "Bash(make test)",
      "Bash(make cli*)",
      "Bash(.claude/skills/git-commit/scripts/status.sh)",
      "Bash(.claude/skills/git-commit/scripts/unstaged-diff.sh *)",
      "Bash(git status *)",
      "Bash(git pull *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(xargs ls)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(cut *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(pwd)",
      "Bash(pngtopnm *)",
      "Bash(ppmtobmp *)",
      "Bash(bmptoppm *)",
      "Bash(jq *)",
      "Bash(make dev)",
      "Bash(make build)"
    ],
    "deny": [
      "Edit(Makefile)",
      "Write(Makefile)",
      "Edit(//**)",
      "Write(//**)",
      "Edit(~/**)",
      "Write(~/**)"
    ],
    "defaultMode": "dontAsk"
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": ["github.com", "*.github.com", "registry.npmjs.org", "*.npmjs.org"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-c.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-absolute-paths.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
